{
  "name": "torquewell-auto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "echo \"Playwright smoke test configured in tests/e2e\"",
    "test:a11y": "echo \"A11y tests configured in tests/a11y\"",
    "lhci": "echo \"Lighthouse CI stub\"",
    "check:i18n": "node scripts/check-i18n.js",
    "check:denylist": "node scripts/check-denylist.js",
    "assets:manifest": "node scripts/generate-manifest.js",
    "prerender": "echo \"Prerender script ready\""
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.2.5",
    "@fontsource/familjen-grotesk": "^5.2.5",
    "@fontsource/noto-sans-devanagari": "^5.2.5",
    "@fontsource/public-sans": "^5.2.5",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "framer-motion": "^12.4.7",
    "fuse.js": "^7.1.0",
    "gsap": "^3.12.7",
    "i18next": "^24.2.2",
    "lenis": "^1.1.20",
    "lucide-react": "^0.477.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.2",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
